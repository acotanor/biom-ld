	note = {Publisher: Nature Publishing Group},
	keywords = {Bacterial genes, Metagenomics, Sequencing},
	pages = {59--65},
	file = {Full Text PDF:/home/aitor/Zotero/storage/KNTXJC7H/Qin et al. - 2010 - A human gut microbial gene catalogue established by metagenomic sequencing.pdf:application/pdf},
